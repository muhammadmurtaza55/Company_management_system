# ====================================================================
# Company Management System - Environment Configuration Template
# ====================================================================
# Instructions:
# 1. For local development, copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Fill in your PostgreSQL database credentials and a secure SECRET_KEY.
# 3. For Render deployment: Configure these variables in the Render Dashboard
#    under Service Settings -> Environment Variables.
# 4. NEVER commit the real '.env' file containing secrets to Git!
# ====================================================================

# --------------------------------------------------------------------
# Application & Security Settings
# --------------------------------------------------------------------
FLASK_APP=run.py
# Set to 'development' for local work, 'production' on Render
FLASK_ENV=production
# In production, debug mode is automatically forced to False
FLASK_DEBUG=0

# Secret Key for cryptographic session signing and CSRF tokens
# Generate a secure 64-character hex key via:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secure_secret_key_minimum_32_characters

# --------------------------------------------------------------------
# PostgreSQL Database Settings (Strictly PostgreSQL only)
# --------------------------------------------------------------------
# Primary connection string (Recommended for Render, Supabase, Neon)
# Schemes supported:
#   postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
#   postgresql://<username>:<password>@<host>:<port>/<database_name>
#
# Render Managed Postgres format example:
# DATABASE_URL=postgresql+psycopg://company_user:password123@dpg-xxxxxx.oregon-postgres.render.com/company_management
#
# Local PostgreSQL format example:
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/company_management

# Discrete fallback settings (used only if DATABASE_URL is omitted)
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=company_management
DB_SSLMODE=prefer

# --------------------------------------------------------------------
# Initial Administrator Account (CLI Provisioning)
# --------------------------------------------------------------------
# Used by CLI commands: 'python run.py create-admin' or 'flask init-admin-env'
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars

# --------------------------------------------------------------------
# Server Network Settings
# --------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
